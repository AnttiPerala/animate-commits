{
  "repo": "../../my-python-app",
  "output": "../captures/python-web",
  "appType": "web",
  "install": "python -m venv .venv && .venv\\Scripts\\python.exe -m pip install -r requirements.txt",
  "start": ".venv\\Scripts\\python.exe -m uvicorn app:app --host 127.0.0.1 --port {port}",
  "url": "http://127.0.0.1:{port}/",
  "maxFrames": 40
}
